# Local Vite /api/contact only (npm run dev).
# Production Lambda reads SMTP from SSM Parameter Store — do NOT put secrets in Lambda Environment.

EMAIL_HOST=outbound.daouoffice.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your@narusec.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=your@narusec.com

# 도입 문의 수신 주소 (로컬 필수 — 미설정 시 발송 실패)
CONTACT_INQUIRY_TO=zerotica@narusec.com

# --- Production SSM (create in AWS; not used by Vite) ---
# /zerotica-contact/smtp-host       String
# /zerotica-contact/smtp-user       String
# /zerotica-contact/smtp-password   SecureString
# /zerotica-contact/mail-to         String
