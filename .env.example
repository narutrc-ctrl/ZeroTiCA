# 웹호스팅(Vercel 등) Environment Variables / 로컬 .env.local 에 설정
# SMTP (backend_mrlee와 동일한 Daou Office 계정 사용 가능)

EMAIL_HOST=outbound.daouoffice.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your@narusec.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=your@narusec.com

# 도입 문의 수신 주소
CONTACT_INQUIRY_TO=zerotica@narusec.com
