---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_DESCRIPTION, NOINDEX_ROBOTS } from "@/seo/pages";

const title = "도입 문의 | ZeroTiCA";
---

<BaseLayout
  title={title}
  description={SITE_DESCRIPTION}
  canonicalPath="/contact"
  robots={NOINDEX_ROBOTS}
>
  <main class="mx-auto max-w-lg px-6 py-20 text-center">
    <h1 class="text-2xl font-bold text-zinc-900">도입 문의</h1>
    <p class="mt-3 text-sm leading-relaxed text-slate-600">
      문의 창이 곧 열립니다. 열리지 않으면 상단의 「도입 문의」 버튼을 이용해 주세요.
    </p>
  </main>
</BaseLayout>
