---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { HOME, SITE_DESCRIPTION } from "@/seo/pages";
---

<BaseLayout
  title={HOME.title}
  description={SITE_DESCRIPTION}
  canonicalPath={HOME.canonicalPath}
  robots={HOME.robots}
  ogTitle={HOME.ogTitle}
  twitterTitle={HOME.twitterTitle}
>
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center gap-6 px-6 py-16">
    <p class="text-sm font-medium text-primary">ZeroTiCA · Astro Phase 1</p>
    <h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl">
      {HOME.title}
    </h1>
    <p class="text-lg leading-relaxed text-slate-600">
      {SITE_DESCRIPTION}
    </p>
    <p class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
      이 페이지는 Astro SSG 뼈대 확인용입니다. 본문 HTML이 빌드 산출물에 포함되는지
      검증한 뒤, Phase 2부터 헤더·푸터·기존 섹션을 옮깁니다.
    </p>
  </main>
</BaseLayout>
