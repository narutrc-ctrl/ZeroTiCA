---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { LandingPage } from "@/views/LandingPage";
import { HOME, SITE_DESCRIPTION } from "@/seo/pages";
---

<BaseLayout
  title={HOME.title}
  description={SITE_DESCRIPTION}
  canonicalPath={HOME.canonicalPath}
  robots={HOME.robots}
  ogTitle={HOME.ogTitle}
  twitterTitle={HOME.twitterTitle}
>
  <!--
    1차: 홈 전체를 하나의 island로 SSR+hydrate.
    본문 텍스트는 빌드 HTML에 포함되고, 문의 CTA는 window 이벤트로 SiteShell 모달과 연결됨.
    이후 섹션별 바다/섬 분해는 유지보수 단계에서 진행.
  -->
  <LandingPage client:load />
</BaseLayout>
