---
import DemoLayout from "@/layouts/DemoLayout.astro";
import { DemoIsland } from "@/components/DemoIsland";
import { SITE_DESCRIPTION, NOINDEX_ROBOTS } from "@/seo/pages";

const title = "이슈 관리 데모 | ZeroTiCA";
const islandUrl = `${Astro.url.pathname.replace(/\/$/, "") || "/"}${Astro.url.search}`;
---

<DemoLayout
  title={title}
  description={SITE_DESCRIPTION}
  canonicalPath="/demo/task"
  robots={NOINDEX_ROBOTS}
>
  <DemoIsland client:load url={islandUrl} />
</DemoLayout>
